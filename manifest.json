{
  "manifest_version": 3,
  "name": "Mute Button for WhatsApp Web",
  "short_name": "WAMute",
  "description": "Adds a simple mute/unmute button inside WhatsApp Web using the browser's native tab mute.",
  "version": "1.0.0",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "permissions": ["tabs"],
  "host_permissions": ["*://web.whatsapp.com/*"],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["*://web.whatsapp.com/*"],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_end"
    }
  ]
}
